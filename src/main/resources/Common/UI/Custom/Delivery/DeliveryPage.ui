$C = "../Common.ui";

$C.@PageOverlay {
}

Group #GiftGridContainer {
  Anchor: (Full: 0);
  LayoutMode: CenterMiddle;

  Group #GiftGrid {
    LayoutMode: Left;

    Group #Slot0 {
      Anchor: (Width: 300, Height: 420, Left: 12, Right: 12);
    }

    Group #Slot1 {
      Anchor: (Width: 300, Height: 420, Left: 12, Right: 12);
    }

    Group #Slot2 {
      Anchor: (Width: 300, Height: 420, Left: 12, Right: 12);
    }
  }
}

$C.@BackButton {}
