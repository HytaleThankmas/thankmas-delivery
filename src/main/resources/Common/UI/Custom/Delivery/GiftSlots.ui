$C = "../Common.ui";

$C.@DecoratedContainer {
  Anchor: (Full: 0);
  LayoutMode: Full;
  Background: #16212f;

  Group #TopBar {
    LayoutMode: Top;

    Label #ParcelTitle {
      Text: "Parcel 1";
      Anchor: (Width: 260, Height: 24, Top: 8);
      Style: (FontSize: 18, TextColor: $C.@ColorDefault, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      MaskTexturePath: $C.@TextHighlightGradientMask;
    }

  }
  Group #Main {
    LayoutMode: Top;
    Anchor: (Top: 54);
    Group #Group2 {
      Anchor:(Top:-10);
      LayoutMode: MiddleCenter;

      Group #PointsGroup {
        Anchor: (Width: 260, Height: 28);
        LayoutMode: Center;

        Group #PointsInnerGroup {
          LayoutMode: Left;
          Anchor: (Height: 28);

          Label #PointsTitle {
            Text: "Points: 0";
            Anchor: (Height: 28);
            Style: (FontSize: 18, TextColor: $C.@ColorGoldHighlight, RenderBold: true, VerticalAlignment: Center);
          }

          Label #BonusPointsTitle {
            Text: "";
            Anchor: (Height: 28);
            Style: (FontSize: 18, TextColor: #83E79E, RenderBold: true, VerticalAlignment: Center);
            Visible: false;
          }
        }
      }

      Group #ParcelImageGroup {
        Anchor: (Width: 128, Height: 128);

        ItemSlot #ParcelImage {
          Anchor: (Width: 128, Height: 128);
          ShowQualityBackground: false;
        }
      }
$C.@SimpleContainer {
      Anchor: (Width: 280, Top: 18, Bottom: 18);
      LayoutMode: Top;
      Label #PositiveText {
        Text: "Positive: 1";
        Anchor: (Width: 260, Top: 6, Bottom: 6, Left:3);
        Style: (FontSize: 20, TextColor: #83E79E, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #NeutralText {
        Text: "Neutral: 1";
        Anchor: (Width: 260, Top: 6, Bottom: 6, Left:3);
        Style: (FontSize: 20, TextColor: #FFD469, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #PositiveText2 {
        Text: "Negative: 1";
        Anchor: (Width: 260, Top: 6, Bottom: 6, Left:3);
        Style: (FontSize: 20, TextColor: #FF9D93, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
}

    }

    $C.@TextButton #ChooseButton {
      Anchor: (Width: 220, Height: 36, Bottom: 4);
      Text: "Choose";
      Visible: true;
    }

  }
}
